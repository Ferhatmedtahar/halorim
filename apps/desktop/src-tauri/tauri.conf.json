{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Halorim",
  "version": "0.1.1",
  "identifier": "com.glowframe.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "files": {
          "/etc/xdg/autostart/halorim.desktop": "linux/halorim-autostart.desktop"
        }
      },
      "rpm": {
        "files": {
          "/etc/xdg/autostart/halorim.desktop": "linux/halorim-autostart.desktop"
        }
      }
    }
  }
}
